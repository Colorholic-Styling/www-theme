{
  "layout": "default",
  "resources": {
    "pages_by_type": {
      "service": {
        "limit": 60,
        "sort": "weight",
        "order": "asc",
        "group_by": {
          "tag_taxonomy": "categories",
          "include_untagged": true
        }
      },
      "team_member": {
        "limit": 60,
        "sort": "weight",
        "order": "asc"
      },
      "news": {
        "limit": 6,
        "sort": "published_at",
        "order": "desc"
      }
    }
  },
  "sections": {
    "hero": {
      "type": "hero",
      "settings": {
        "theme": "{{ page.blocks[0].theme }}",
        "anchor": "{{ page.blocks[0].anchor }}",
        "align": "{{ page.blocks[0].align }}",
        "eyebrow": "{{ page.blocks[0].eyebrow }}",
        "title": "{{ page.blocks[0].title }}",
        "bodyHtml": "{{ page.blocks[0].bodyHtml }}",
        "primary_label": "{{ page.blocks[0].primary.label }}",
        "primary_url": "{{ page.blocks[0].primary.href }}",
        "secondary_label": "{{ page.blocks[0].secondary.label }}",
        "secondary_url": "{{ page.blocks[0].secondary.href }}",
        "picture": "{{ page.blocks[0].picture }}",
        "pictureAlt": "{{ page.blocks[0].pictureAlt }}"
      }
    },
    "features": {
      "type": "features",
      "settings": {
        "theme": "{{ page.blocks[1].theme }}",
        "anchor": "{{ page.blocks[1].anchor }}",
        "align": "{{ page.blocks[1].align }}",
        "columns": "{{ page.blocks[1].columns }}",
        "eyebrow": "{{ page.blocks[1].eyebrow }}",
        "title": "{{ page.blocks[1].title }}",
        "bodyHtml": "{{ page.blocks[1].bodyHtml }}"
      },
      "blocks": {
        "feature-1": {
          "type": "feature",
          "settings": {
            "icon": "{{ page.blocks[1].features[0].icon }}",
            "name": "{{ page.blocks[1].features[0].name }}",
            "description": "{{ page.blocks[1].features[0].description }}"
          }
        },
        "feature-2": {
          "type": "feature",
          "settings": {
            "icon": "{{ page.blocks[1].features[1].icon }}",
            "name": "{{ page.blocks[1].features[1].name }}",
            "description": "{{ page.blocks[1].features[1].description }}"
          }
        },
        "feature-3": {
          "type": "feature",
          "settings": {
            "icon": "{{ page.blocks[1].features[2].icon }}",
            "name": "{{ page.blocks[1].features[2].name }}",
            "description": "{{ page.blocks[1].features[2].description }}"
          }
        }
      },
      "block_order": [
        "feature-1",
        "feature-2",
        "feature-3"
      ]
    },
    "services": {
      "type": "services",
      "settings": {
        "theme": "{{ page.blocks[2].theme }}",
        "anchor": "{{ page.blocks[2].anchor }}",
        "align": "{{ page.blocks[2].align }}",
        "eyebrow": "{{ page.blocks[2].eyebrow }}",
        "title": "{{ page.blocks[2].title }}",
        "bodyHtml": "{{ page.blocks[2].bodyHtml }}",
        "note": "{{ page.blocks[2].note }}"
      }
    },
    "steps": {
      "type": "steps",
      "settings": {
        "theme": "{{ page.blocks[3].theme }}",
        "anchor": "{{ page.blocks[3].anchor }}",
        "align": "{{ page.blocks[3].align }}",
        "eyebrow": "{{ page.blocks[3].eyebrow }}",
        "title": "{{ page.blocks[3].title }}",
        "bodyHtml": "{{ page.blocks[3].bodyHtml }}"
      },
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "name": "{{ page.blocks[3].steps[0].name }}",
            "description": "{{ page.blocks[3].steps[0].description }}"
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "name": "{{ page.blocks[3].steps[1].name }}",
            "description": "{{ page.blocks[3].steps[1].description }}"
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "name": "{{ page.blocks[3].steps[2].name }}",
            "description": "{{ page.blocks[3].steps[2].description }}"
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "name": "{{ page.blocks[3].steps[3].name }}",
            "description": "{{ page.blocks[3].steps[3].description }}"
          }
        }
      },
      "block_order": [
        "step-1",
        "step-2",
        "step-3",
        "step-4"
      ]
    },
    "studio": {
      "type": "gallery",
      "settings": {
        "theme": "{{ page.blocks[4].theme }}",
        "anchor": "{{ page.blocks[4].anchor }}",
        "align": "{{ page.blocks[4].align }}",
        "columns": "{{ page.blocks[4].columns }}",
        "eyebrow": "{{ page.blocks[4].eyebrow }}",
        "title": "{{ page.blocks[4].title }}",
        "bodyHtml": "{{ page.blocks[4].bodyHtml }}"
      },
      "blocks": {
        "picture-1": {
          "type": "picture",
          "settings": {
            "src": "{{ page.blocks[4].pictures[0].src }}",
            "caption": "{{ page.blocks[4].pictures[0].caption }}"
          }
        },
        "picture-2": {
          "type": "picture",
          "settings": {
            "src": "{{ page.blocks[4].pictures[1].src }}",
            "caption": "{{ page.blocks[4].pictures[1].caption }}"
          }
        },
        "picture-3": {
          "type": "picture",
          "settings": {
            "src": "{{ page.blocks[4].pictures[2].src }}",
            "caption": "{{ page.blocks[4].pictures[2].caption }}"
          }
        },
        "picture-4": {
          "type": "picture",
          "settings": {
            "src": "{{ page.blocks[4].pictures[3].src }}",
            "caption": "{{ page.blocks[4].pictures[3].caption }}"
          }
        },
        "picture-5": {
          "type": "picture",
          "settings": {
            "src": "{{ page.blocks[4].pictures[4].src }}",
            "caption": "{{ page.blocks[4].pictures[4].caption }}"
          }
        },
        "picture-6": {
          "type": "picture",
          "settings": {
            "src": "{{ page.blocks[4].pictures[5].src }}",
            "caption": "{{ page.blocks[4].pictures[5].caption }}"
          }
        }
      },
      "block_order": [
        "picture-1",
        "picture-2",
        "picture-3",
        "picture-4",
        "picture-5",
        "picture-6"
      ]
    },
    "team": {
      "type": "team",
      "settings": {
        "theme": "{{ page.blocks[5].theme }}",
        "anchor": "{{ page.blocks[5].anchor }}",
        "align": "{{ page.blocks[5].align }}",
        "eyebrow": "{{ page.blocks[5].eyebrow }}",
        "title": "{{ page.blocks[5].title }}",
        "bodyHtml": "{{ page.blocks[5].bodyHtml }}"
      }
    },
    "faq": {
      "type": "faq",
      "settings": {
        "theme": "{{ page.blocks[6].theme }}",
        "anchor": "{{ page.blocks[6].anchor }}",
        "align": "{{ page.blocks[6].align }}",
        "eyebrow": "{{ page.blocks[6].eyebrow }}",
        "title": "{{ page.blocks[6].title }}",
        "bodyHtml": "{{ page.blocks[6].bodyHtml }}"
      },
      "blocks": {
        "question-1": {
          "type": "faq",
          "settings": {
            "question": "{{ page.blocks[6].faqs[0].question }}",
            "answerHtml": "{{ page.blocks[6].faqs[0].answerHtml }}"
          }
        },
        "question-2": {
          "type": "faq",
          "settings": {
            "question": "{{ page.blocks[6].faqs[1].question }}",
            "answerHtml": "{{ page.blocks[6].faqs[1].answerHtml }}"
          }
        },
        "question-3": {
          "type": "faq",
          "settings": {
            "question": "{{ page.blocks[6].faqs[2].question }}",
            "answerHtml": "{{ page.blocks[6].faqs[2].answerHtml }}"
          }
        }
      },
      "block_order": [
        "question-1",
        "question-2",
        "question-3"
      ]
    },
    "news": {
      "type": "news-list",
      "settings": {
        "theme": "{{ page.blocks[7].theme }}",
        "anchor": "{{ page.blocks[7].anchor }}",
        "align": "{{ page.blocks[7].align }}",
        "eyebrow": "{{ page.blocks[7].eyebrow }}",
        "title": "{{ page.blocks[7].title }}",
        "bodyHtml": "{{ page.blocks[7].bodyHtml }}",
        "indexHref": "{{ page.blocks[7].indexHref }}",
        "indexLabel": "{{ page.blocks[7].indexLabel }}"
      }
    },
    "contact": {
      "type": "contact",
      "settings": {
        "theme": "{{ page.blocks[8].theme }}",
        "anchor": "{{ page.blocks[8].anchor }}",
        "align": "{{ page.blocks[8].align }}",
        "eyebrow": "{{ page.blocks[8].eyebrow }}",
        "title": "{{ page.blocks[8].title }}",
        "bodyHtml": "{{ page.blocks[8].bodyHtml }}",
        "address": "{{ page.blocks[8].addressLines | join: '\n' }}",
        "hours": "{{ page.blocks[8].hoursLines | join: '\n' }}",
        "phone": "{{ page.blocks[8].phone }}",
        "email": "{{ page.blocks[8].email }}",
        "whatsappHref": "{{ page.blocks[8].whatsappHref }}",
        "map_label": "{{ page.blocks[8].map.label }}",
        "map_url": "{{ page.blocks[8].map.href }}",
        "booking_label": "{{ page.blocks[8].booking.label }}",
        "booking_url": "{{ page.blocks[8].booking.href }}"
      }
    },
    "cta": {
      "type": "cta",
      "settings": {
        "theme": "{{ page.blocks[9].theme }}",
        "anchor": "{{ page.blocks[9].anchor }}",
        "eyebrow": "{{ page.blocks[9].eyebrow }}",
        "title": "{{ page.blocks[9].title }}",
        "bodyHtml": "{{ page.blocks[9].bodyHtml }}",
        "picture": "{{ page.blocks[9].picture }}",
        "button_label": "{{ page.blocks[9].button.label }}",
        "button_url": "{{ page.blocks[9].button.href }}"
      }
    }
  },
  "order": [
    "hero",
    "features",
    "services",
    "steps",
    "studio",
    "team",
    "faq",
    "news",
    "contact",
    "cta"
  ]
}
