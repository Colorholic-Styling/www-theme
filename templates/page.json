{
  "layout": "default",
  "sections": {
    "hero": {
      "type": "hero",
      "settings": {
        "theme": "{{ page.blocks[0].theme }}",
        "anchor": "{{ page.blocks[0].anchor }}",
        "align": "{{ page.blocks[0].align }}",
        "eyebrow": "{{ page.blocks[0].eyebrow }}",
        "title": "{{ page.blocks[0].title }}",
        "bodyHtml": "{{ page.blocks[0].bodyHtml }}",
        "primary_label": "{{ page.blocks[0].primary.label }}",
        "primary_url": "{{ page.blocks[0].primary.href }}",
        "secondary_label": "{{ page.blocks[0].secondary.label }}",
        "secondary_url": "{{ page.blocks[0].secondary.href }}",
        "picture": "{{ page.blocks[0].picture }}",
        "pictureAlt": "{{ page.blocks[0].pictureAlt }}"
      }
    },
    "features": {
      "type": "features",
      "settings": {
        "theme": "{{ page.blocks[1].theme }}",
        "anchor": "{{ page.blocks[1].anchor }}",
        "align": "{{ page.blocks[1].align }}",
        "columns": "{{ page.blocks[1].columns }}",
        "eyebrow": "{{ page.blocks[1].eyebrow }}",
        "title": "{{ page.blocks[1].title }}",
        "bodyHtml": "{{ page.blocks[1].bodyHtml }}"
      },
      "blocks": {
        "feature-1": {
          "type": "feature",
          "settings": {
            "icon": "{{ page.blocks[1].features[0].icon }}",
            "name": "{{ page.blocks[1].features[0].name }}",
            "description": "{{ page.blocks[1].features[0].description }}"
          }
        },
        "feature-2": {
          "type": "feature",
          "settings": {
            "icon": "{{ page.blocks[1].features[1].icon }}",
            "name": "{{ page.blocks[1].features[1].name }}",
            "description": "{{ page.blocks[1].features[1].description }}"
          }
        },
        "feature-3": {
          "type": "feature",
          "settings": {
            "icon": "{{ page.blocks[1].features[2].icon }}",
            "name": "{{ page.blocks[1].features[2].name }}",
            "description": "{{ page.blocks[1].features[2].description }}"
          }
        }
      },
      "block_order": [
        "feature-1",
        "feature-2",
        "feature-3"
      ]
    },
    "services": {
      "type": "services",
      "settings": {
        "theme": "{{ page.blocks[2].theme }}",
        "anchor": "{{ page.blocks[2].anchor }}",
        "align": "{{ page.blocks[2].align }}",
        "eyebrow": "{{ page.blocks[2].eyebrow }}",
        "title": "{{ page.blocks[2].title }}",
        "bodyHtml": "{{ page.blocks[2].bodyHtml }}",
        "note": "{{ page.blocks[2].note }}"
      },
      "blocks": {
        "service-1": {
          "type": "service",
          "settings": {
            "name": "{{ page.blocks[2].services[0].name }}",
            "description": "{{ page.blocks[2].services[0].description }}",
            "duration": "{{ page.blocks[2].services[0].duration }}",
            "price": "{{ page.blocks[2].services[0].price }}",
            "label": "{{ page.blocks[2].services[0].label }}",
            "href": "{{ page.blocks[2].services[0].href }}"
          }
        },
        "service-2": {
          "type": "service",
          "settings": {
            "name": "{{ page.blocks[2].services[1].name }}",
            "description": "{{ page.blocks[2].services[1].description }}",
            "duration": "{{ page.blocks[2].services[1].duration }}",
            "price": "{{ page.blocks[2].services[1].price }}",
            "label": "{{ page.blocks[2].services[1].label }}",
            "href": "{{ page.blocks[2].services[1].href }}"
          }
        },
        "service-3": {
          "type": "service",
          "settings": {
            "name": "{{ page.blocks[2].services[2].name }}",
            "description": "{{ page.blocks[2].services[2].description }}",
            "duration": "{{ page.blocks[2].services[2].duration }}",
            "price": "{{ page.blocks[2].services[2].price }}",
            "label": "{{ page.blocks[2].services[2].label }}",
            "href": "{{ page.blocks[2].services[2].href }}"
          }
        }
      },
      "block_order": [
        "service-1",
        "service-2",
        "service-3"
      ]
    },
    "steps": {
      "type": "steps",
      "settings": {
        "theme": "{{ page.blocks[3].theme }}",
        "anchor": "{{ page.blocks[3].anchor }}",
        "align": "{{ page.blocks[3].align }}",
        "eyebrow": "{{ page.blocks[3].eyebrow }}",
        "title": "{{ page.blocks[3].title }}",
        "bodyHtml": "{{ page.blocks[3].bodyHtml }}"
      },
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "name": "{{ page.blocks[3].steps[0].name }}",
            "description": "{{ page.blocks[3].steps[0].description }}"
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "name": "{{ page.blocks[3].steps[1].name }}",
            "description": "{{ page.blocks[3].steps[1].description }}"
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "name": "{{ page.blocks[3].steps[2].name }}",
            "description": "{{ page.blocks[3].steps[2].description }}"
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "name": "{{ page.blocks[3].steps[3].name }}",
            "description": "{{ page.blocks[3].steps[3].description }}"
          }
        }
      },
      "block_order": [
        "step-1",
        "step-2",
        "step-3",
        "step-4"
      ]
    },
    "team": {
      "type": "team",
      "settings": {
        "theme": "{{ page.blocks[4].theme }}",
        "anchor": "{{ page.blocks[4].anchor }}",
        "align": "{{ page.blocks[4].align }}",
        "eyebrow": "{{ page.blocks[4].eyebrow }}",
        "title": "{{ page.blocks[4].title }}",
        "bodyHtml": "{{ page.blocks[4].bodyHtml }}"
      },
      "blocks": {
        "member-1": {
          "type": "member",
          "settings": {
            "name": "{{ page.blocks[4].members[0].name }}",
            "role": "{{ page.blocks[4].members[0].role }}",
            "bio": "{{ page.blocks[4].members[0].bio }}",
            "picture": "{{ page.blocks[4].members[0].picture }}"
          }
        },
        "member-2": {
          "type": "member",
          "settings": {
            "name": "{{ page.blocks[4].members[1].name }}",
            "role": "{{ page.blocks[4].members[1].role }}",
            "bio": "{{ page.blocks[4].members[1].bio }}",
            "picture": "{{ page.blocks[4].members[1].picture }}"
          }
        },
        "member-3": {
          "type": "member",
          "settings": {
            "name": "{{ page.blocks[4].members[2].name }}",
            "role": "{{ page.blocks[4].members[2].role }}",
            "bio": "{{ page.blocks[4].members[2].bio }}",
            "picture": "{{ page.blocks[4].members[2].picture }}"
          }
        }
      },
      "block_order": [
        "member-1",
        "member-2",
        "member-3"
      ]
    },
    "faq": {
      "type": "faq",
      "settings": {
        "theme": "{{ page.blocks[5].theme }}",
        "anchor": "{{ page.blocks[5].anchor }}",
        "align": "{{ page.blocks[5].align }}",
        "eyebrow": "{{ page.blocks[5].eyebrow }}",
        "title": "{{ page.blocks[5].title }}",
        "bodyHtml": "{{ page.blocks[5].bodyHtml }}"
      },
      "blocks": {
        "question-1": {
          "type": "faq",
          "settings": {
            "question": "{{ page.blocks[5].faqs[0].question }}",
            "answerHtml": "{{ page.blocks[5].faqs[0].answerHtml }}"
          }
        },
        "question-2": {
          "type": "faq",
          "settings": {
            "question": "{{ page.blocks[5].faqs[1].question }}",
            "answerHtml": "{{ page.blocks[5].faqs[1].answerHtml }}"
          }
        },
        "question-3": {
          "type": "faq",
          "settings": {
            "question": "{{ page.blocks[5].faqs[2].question }}",
            "answerHtml": "{{ page.blocks[5].faqs[2].answerHtml }}"
          }
        }
      },
      "block_order": [
        "question-1",
        "question-2",
        "question-3"
      ]
    },
    "news": {
      "type": "news-list",
      "settings": {
        "theme": "{{ page.blocks[6].theme }}",
        "anchor": "{{ page.blocks[6].anchor }}",
        "align": "{{ page.blocks[6].align }}",
        "eyebrow": "{{ page.blocks[6].eyebrow }}",
        "title": "{{ page.blocks[6].title }}",
        "bodyHtml": "{{ page.blocks[6].bodyHtml }}",
        "hasNews": "{% if page.blocks[6].hasNews %}yes{% endif %}",
        "indexHref": "{{ page.blocks[6].indexHref }}",
        "indexLabel": "{{ page.blocks[6].indexLabel }}"
      },
      "blocks": {
        "article-1": {
          "type": "article",
          "settings": {
            "title": "{{ page.blocks[6].news[0].title }}",
            "href": "{{ page.blocks[6].news[0].href }}",
            "summary": "{{ page.blocks[6].news[0].summary }}",
            "picture": "{{ page.blocks[6].news[0].picture }}",
            "dateText": "{{ page.blocks[6].news[0].dateText }}",
            "dateIso": "{{ page.blocks[6].news[0].dateIso }}"
          }
        },
        "article-2": {
          "type": "article",
          "settings": {
            "title": "{{ page.blocks[6].news[1].title }}",
            "href": "{{ page.blocks[6].news[1].href }}",
            "summary": "{{ page.blocks[6].news[1].summary }}",
            "picture": "{{ page.blocks[6].news[1].picture }}",
            "dateText": "{{ page.blocks[6].news[1].dateText }}",
            "dateIso": "{{ page.blocks[6].news[1].dateIso }}"
          }
        },
        "article-3": {
          "type": "article",
          "settings": {
            "title": "{{ page.blocks[6].news[2].title }}",
            "href": "{{ page.blocks[6].news[2].href }}",
            "summary": "{{ page.blocks[6].news[2].summary }}",
            "picture": "{{ page.blocks[6].news[2].picture }}",
            "dateText": "{{ page.blocks[6].news[2].dateText }}",
            "dateIso": "{{ page.blocks[6].news[2].dateIso }}"
          }
        }
      },
      "block_order": [
        "article-1",
        "article-2",
        "article-3"
      ]
    },
    "contact": {
      "type": "contact",
      "settings": {
        "theme": "{{ page.blocks[7].theme }}",
        "anchor": "{{ page.blocks[7].anchor }}",
        "align": "{{ page.blocks[7].align }}",
        "eyebrow": "{{ page.blocks[7].eyebrow }}",
        "title": "{{ page.blocks[7].title }}",
        "bodyHtml": "{{ page.blocks[7].bodyHtml }}",
        "address": "{{ page.blocks[7].addressLines | join: '\n' }}",
        "hours": "{{ page.blocks[7].hoursLines | join: '\n' }}",
        "phone": "{{ page.blocks[7].phone }}",
        "email": "{{ page.blocks[7].email }}",
        "whatsappHref": "{{ page.blocks[7].whatsappHref }}",
        "map_label": "{{ page.blocks[7].map.label }}",
        "map_url": "{{ page.blocks[7].map.href }}",
        "booking_label": "{{ page.blocks[7].booking.label }}",
        "booking_url": "{{ page.blocks[7].booking.href }}"
      }
    },
    "cta": {
      "type": "cta",
      "settings": {
        "theme": "{{ page.blocks[8].theme }}",
        "anchor": "{{ page.blocks[8].anchor }}",
        "eyebrow": "{{ page.blocks[8].eyebrow }}",
        "title": "{{ page.blocks[8].title }}",
        "bodyHtml": "{{ page.blocks[8].bodyHtml }}",
        "picture": "{{ page.blocks[8].picture }}",
        "button_label": "{{ page.blocks[8].button.label }}",
        "button_url": "{{ page.blocks[8].button.href }}"
      }
    }
  },
  "order": [
    "hero",
    "features",
    "services",
    "steps",
    "team",
    "faq",
    "news",
    "contact",
    "cta"
  ]
}
