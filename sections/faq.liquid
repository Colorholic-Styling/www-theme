{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "bodyHtml",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answerHtml",
          "label": "Answer"
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}Native <details> disclosure — no JavaScript, so the strict CSP holds.{%- endcomment -%}
{% assign faqs = section.settings.faqs | default: section.blocks %}

<section class="section section--{{ section.settings.theme | escape }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="section__inner section__inner--narrow">
    {% render '/snippets/section-head', settings: section.settings %}

    <div class="faq">
      {% for row in faqs %}
      {% assign item = row.settings | default: row %}
      <details class="faq__item">
        <summary class="faq__question">{{ item.question | escape }}</summary>
        {% if item.answerHtml != blank %}<div class="faq__answer prose">{{ item.answerHtml }}</div>{% endif %}
      </details>
      {% endfor %}
    </div>
  </div>
</section>
