{% schema %}
{
  "name": "Steps / process",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "bodyHtml",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ]
}
{% endschema %}

{% assign steps = section.settings.steps | default: section.blocks %}

<section class="section section--{{ section.settings.theme | escape }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="section__inner">
    {% render '/snippets/section-head', settings: section.settings %}

    {%- comment -%}
      steps__index and steps__text are kept as hooks, not for their own styling
      — the base styles are utilities now — but because the dark theme repaints
      them from the section wrapper (.section--dark .steps__index). That
      selector is unlayered, so it still wins over the utilities layer.
    {%- endcomment -%}
    <ol class="grid gap-[1.6rem] m-0 p-0 list-none">
      {% for row in steps %}
      {% assign step = row.settings | default: row %}
      <li class="flex gap-[1.1rem] items-start">
        {%- comment -%}
          text-[1rem] rather than text-base: Tailwind's named sizes also set a
          line-height (1.5), where the original rule set font-size alone and
          inherited body's 1.75. Arbitrary sizes carry no line-height.
        {%- endcomment -%}
        <span class="steps__index shrink-0 w-[2.4rem] h-[2.4rem] rounded-[50%] grid place-items-center font-display text-[1rem] bg-accent-soft text-accent-deep" aria-hidden="true">{{ step.index | default: forloop.index }}</span>
        <div class="steps__text">
          {% if step.name != blank %}<h3 class="mt-1 mb-[.35rem] text-[1.1rem]">{{ step.name | escape }}</h3>{% endif %}
          {% if step.description != blank %}<p class="m-0 text-ink-soft">{{ step.description | escape }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
