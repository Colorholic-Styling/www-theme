{% schema %}
{
  "name": "Services / price list",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "bodyHtml",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "href",
          "label": "Booking link"
        },
        {
          "type": "url",
          "id": "detailHref",
          "label": "Detail page"
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Same resource rule as sections/news-list.liquid:

    section.settings.services — a CMS `services` block, projected by src/blocks.ts
    pages_by_type['service'].pages  — published `service` pages declared by the
                                      JSON route template, lightest weight first
    pages_by_type['service'].groups — the same pages grouped by category tag
    serviceList               — temporary compatibility alias during rollout
    section.blocks            — services written into a JSON template by hand

  `href` is the booking link in every source. `detailHref` is set only for
  services that are pages of their own; a hand-written row has none and simply
  renders without the "full detail" link.
{%- endcomment -%}
{% assign serviceResource = pages_by_type['service'] %}
{% assign services = section.settings.services | default: serviceResource.pages | default: serviceList | default: section.blocks %}
{% assign resourceGroups = serviceResource.groups %}
{% assign resourceGrouped = false %}
{% if section.settings.services == blank and resourceGroups.size > 1 %}{% assign resourceGrouped = true %}{% endif %}

{%- comment -%}
  Category tabs, the way the Fresha booking page groups the same list: the price
  list runs to a dozen rows, which is a long scroll on the homepage.

  Tabs are opt-in by the data, not by a setting: they appear only when EVERY
  service carries a `category` and there is more than one distinct value.
  A part-categorised list would silently drop the rows with no category, and a
  single tab is just a heading with extra clicks — both fall back to the flat
  list below.

  `where: 'category'` cannot do the counting on its own: Liquid treats an empty
  string as truthy, so a blank category still passes it. Hence the loop, which
  skips blanks and adds up only what a tab would actually show.
{%- endcomment -%}
{% assign categories = services | map: 'category' | uniq %}
{% assign tabCount = 0 %}
{% assign taggedCount = 0 %}
{% for category in categories %}
  {% if category == blank %}{% continue %}{% endif %}
  {% assign tabCount = tabCount | plus: 1 %}
  {% assign categoryRows = services | where: 'category', category %}
  {% assign taggedCount = taggedCount | plus: categoryRows.size %}
{% endfor %}
{% assign tabbed = false %}
{% if tabCount > 1 and taggedCount == services.size %}{% assign tabbed = true %}{% endif %}
{% assign tabId = section.settings.anchor | default: section.id | default: 'services' %}

<section class="section section--{{ section.settings.theme | escape }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="section__inner">
    {% render '/snippets/section-head', settings: section.settings %}

    {% if resourceGrouped %}
    <div class="tabs">
      {% for group in resourceGroups %}
      <input class="tabs__radio" type="radio" name="{{ tabId | escape }}-tab" id="{{ tabId | escape }}-tag-{{ forloop.index }}"{% if forloop.first %} checked{% endif %}>
      <label class="tabs__label" for="{{ tabId | escape }}-tag-{{ forloop.index }}">{{ group.name | escape }}</label>
      <div class="tabs__panel">
        <ul class="price-list">
          {% for service in group.pages %}
          {% render '/snippets/price-row', service: service %}
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
    {% elsif tabbed %}
    {%- comment -%}
      A radio group, not JavaScript — the CSP forbids inline script, the same
      reason the FAQ is a <details> and the mobile menu a checkbox. Each tab is
      `input + label + panel` in DOM order so the whole thing is two adjacent
      sibling selectors and no per-tab CSS; flex `order` lifts the labels into a
      row above the panels. Same `name` on every radio, so the arrow keys move
      between tabs for free.
    {%- endcomment -%}
    <div class="tabs">
      {% for category in categories %}
      {% assign categoryRows = services | where: 'category', category %}
      <input class="tabs__radio" type="radio" name="{{ tabId | escape }}-tab" id="{{ tabId | escape }}-tab-{{ forloop.index }}"{% if forloop.first %} checked{% endif %}>
      <label class="tabs__label" for="{{ tabId | escape }}-tab-{{ forloop.index }}">{{ category | escape }}</label>
      <div class="tabs__panel">
        <ul class="price-list">
          {% for service in categoryRows %}
          {% render '/snippets/price-row', service: service %}
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
    {% elsif services.size > 0 %}
    <ul class="price-list">
      {% for row in services %}
      {% assign service = row.settings | default: row %}
      {% render '/snippets/price-row', service: service %}
      {% endfor %}
    </ul>
    {% endif %}

    {% if section.settings.note != blank %}<p class="section__note">{{ section.settings.note | escape }}</p>{% endif %}
  </div>
</section>
