{% schema %}
{
  "name": "Team",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "bodyHtml",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Member",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio"
        },
        {
          "type": "image_picker",
          "id": "picture",
          "label": "Picture"
        },
        {
          "type": "url",
          "id": "href",
          "label": "Profile page"
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Same resource rule as sections/news-list.liquid:

    section.settings.members — a CMS `team` block, projected by src/blocks.ts
    pages_by_type['team_member'].pages — published team pages declared by the
                                         JSON route template, lightest weight first
    teamMembers              — temporary compatibility alias during rollout
    section.blocks           — members written into a JSON template by hand

  `href` is set only for members that are pages of their own; a hand-written row
  has none and simply renders without a link.
{%- endcomment -%}
{% assign members = section.settings.members | default: pages_by_type['team_member'].pages | default: teamMembers | default: section.blocks %}

<section class="section section--{{ section.settings.theme | escape }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="section__inner">
    {% render '/snippets/section-head', settings: section.settings %}

    {% if members.size > 0 %}
    <ul class="card-grid card-grid--3">
      {% for row in members %}
      {% assign member = row.settings | default: row %}
      <li class="member">
        {%- comment -%}
          Members without a portrait get an empty tile rather than nothing, so a
          partly-photographed team still lines up as a grid instead of leaving
          one column's text riding up above the others.
        {%- endcomment -%}
        {% if member.href != blank %}<a class="member__link" href="{{ member.href | escape }}">{% endif %}
        {% if member.picture != blank %}
        <img class="rounded-full aspect-square block mb-4 w-full" src="{{ member.picture | escape }}" alt="{{ member.name | escape }}" loading="lazy" width="100" height="100">
        {% else %}
        <span class="rounded-full aspect-square block mb-4 w-full bg-[#f3ced1]" aria-hidden="true"></span>
        {% endif %}
        <h3 class="member__name">{{ member.name | escape }}</h3>
        {% if member.href != blank %}</a>{% endif %}
        {% if member.role != blank %}<p class="member__role">{{ member.role | escape }}</p>{% endif %}
        {% if member.bio != blank %}<p class="member__bio">{{ member.bio | escape }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
</section>
