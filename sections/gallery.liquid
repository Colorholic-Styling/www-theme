{% schema %}
{
  "name": "Gallery",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "bodyHtml",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "picture",
      "name": "Picture",
      "settings": [
        {
          "type": "image_picker",
          "id": "src",
          "label": "Picture"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ]
}
{% endschema %}

{% assign pictures = section.settings.pictures | default: section.blocks %}

{%- comment -%}
  Tailwind finds classes by scanning this file for literal strings, so the
  column count has to be mapped to whole utility names. Interpolating it —
  `grid-cols-{{ columns }}` — compiles to no CSS at all and fails silently:
  the markup looks right and the grid renders as a single column.

  `nav:` is this theme's 721px breakpoint (see assets-source/site.css), which
  is where 3- and 4-column galleries used to collapse to 2.
{%- endcomment -%}
{% assign columns = section.settings.columns | default: 3 %}
{% case columns %}
  {% when 2, '2' %}{% assign column_classes = 'grid-cols-2' %}
  {% when 4, '4' %}{% assign column_classes = 'grid-cols-2 nav:grid-cols-4' %}
  {% else %}{% assign column_classes = 'grid-cols-2 nav:grid-cols-3' %}
{% endcase %}

<section class="section section--{{ section.settings.theme | escape }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="section__inner">
    {% render '/snippets/section-head', settings: section.settings %}

    <ul class="grid gap-4 m-0 p-0 list-none {{ column_classes }}">
      {% for row in pictures %}
      {% assign picture = row.settings | default: row %}
      <li>
        <figure class="m-0">
          <img class="w-full aspect-square object-cover rounded-card bg-rose-tint"
               src="{{ picture.src | escape }}" alt="{{ picture.caption | escape }}" loading="lazy">
          {% if picture.caption != blank %}<figcaption class="mt-2 text-meta text-ink-muted">{{ picture.caption | escape }}</figcaption>{% endif %}
        </figure>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
