{% schema %}
{
  "name": "Statistics",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "bodyHtml",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ]
}
{% endschema %}

{% assign stats = section.settings.stats | default: section.blocks %}

<section class="section section--{{ section.settings.theme | escape }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="section__inner">
    {% render '/snippets/section-head', settings: section.settings %}

    {%- comment -%}
      stats__value and stats__label stay as hooks for the dark theme's repaint
      (.section--dark .stats__value); their base styles are utilities.
    {%- endcomment -%}
    <ul class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-6 m-0 p-0 list-none text-center">
      {% for row in stats %}
      {% assign stat = row.settings | default: row %}
      <li>
        <p class="stats__value m-0 font-display text-[clamp(2rem,4vw,2.8rem)] text-accent">{{ stat.value | escape }}</p>
        {% if stat.label != blank %}<p class="stats__label mt-[.3rem] mb-0 text-[.9rem] text-ink-muted">{{ stat.label | escape }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
